{
  "name": "tamperbox-doc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "dev:worker": "npm run build && wrangler dev --local --port 8787",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && npm run check:links",
    "check:links": "node scripts/check-links.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "deploy:dry-run": "npm run build && wrangler deploy --env production --dry-run",
    "deploy:production": "npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "^4.151.2"
  }
}
