---
const { entry } = Astro.locals.starlightRoute;
const data = entry.data;
const markdownPath = Astro.url.pathname === '/' ? '/index.md' : `${Astro.url.pathname.replace(/\/$/, '')}.md`;
const parts = Astro.url.pathname.split('/').filter(Boolean);
const section = parts[0] ? parts[0].replaceAll('-', ' ') : undefined;
---
<nav class="tb-breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Docs</a>
  {section && <><span aria-hidden="true">/</span><span>{section}</span></>}
</nav>
<h1 class="tb-page-title" id="starlight__page-title">{data.title}</h1>
{data.description && <p class="tb-page-description">{data.description}</p>}
<tamperbox-page-tools data-markdown-path={markdownPath}>
  <div class="tb-page-meta">
    <a href={markdownPath}>Open Markdown</a>
    <button type="button" data-copy-page><span data-copy-label aria-live="polite">Copy page</span></button>
  </div>
</tamperbox-page-tools>
<script>
  class TamperboxPageTools extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('[data-copy-page]');
      const label = this.querySelector<HTMLElement>('[data-copy-label]');
      button?.addEventListener('click', async () => {
        try {
          const response = await fetch(this.dataset.markdownPath ?? '');
          if (!response.ok) throw new Error('Markdown unavailable');
          await navigator.clipboard.writeText(await response.text());
          if (label) label.textContent = 'Copied';
        } catch {
          if (label) label.textContent = 'Open Markdown to copy';
        }
        window.setTimeout(() => { if (label) label.textContent = 'Copy page'; }, 2200);
      });
    }
  }
  customElements.define('tamperbox-page-tools', TamperboxPageTools);
</script>
