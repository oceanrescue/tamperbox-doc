---
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
---

<a class="tb-site-link" href="https://tamperbox.dev/" title="Open the Tamperbox tools on tamperbox.dev">
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="7" height="7" rx="1.5" />
    <rect x="14" y="3" width="7" height="7" rx="1.5" />
    <rect x="3" y="14" width="7" height="7" rx="1.5" />
    <rect x="14" y="14" width="7" height="7" rx="1.5" />
  </svg>
  <span>Open tools</span>
</a>
<span class="tb-site-divider" aria-hidden="true"></span>
<SocialIcons />

<style>
  .tb-site-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--tb-accent-border);
    border-radius: var(--tb-radius-control);
    background: var(--tb-accent-wash);
    color: var(--tb-accent);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  .tb-site-link:hover {
    background: var(--tb-accent-fill);
    border-color: var(--tb-accent-fill);
    color: var(--tb-on-accent);
  }

  .tb-site-link:focus-visible {
    outline: 2px solid var(--tb-accent);
    outline-offset: 2px;
  }

  .tb-site-link svg {
    flex-shrink: 0;
  }

  .tb-site-divider {
    width: 1px;
    height: 1.25rem;
    background: var(--tb-border-default);
  }
</style>
