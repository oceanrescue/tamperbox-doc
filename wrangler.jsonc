{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tamperbox-doc-local",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "production": {
      "name": "tamperbox-doc",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "docs.tamperbox.dev",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        }
      }
    }
  }
}
